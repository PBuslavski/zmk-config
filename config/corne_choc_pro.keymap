#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    chosen { zmk,physical-layout = &five_col_layout; };
};

/ {
    behaviors {
        coma_semicolon: coma_semicolon {
            compatible = "zmk,behavior-tap-dance";
            label = "COMA_SEMICOLON";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SEMICOLON>;
        };

        period_colon: period_colon {
            compatible = "zmk,behavior-tap-dance";
            label = "PERIOD_COLON";
            #binding-cells = <0>;
            bindings = <&kp PERIOD>, <&kp COLON>;
        };

        question_exclamation: question_exclamation {
            compatible = "zmk,behavior-tap-dance";
            label = "QUESTION_EXCLAMATION";
            #binding-cells = <0>;
            bindings = <&kp QUESTION>, <&kp EXCLAMATION>;
        };

        HRL: HRL {
            compatible = "zmk,behavior-hold-tap";
            label = "HRL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
        };

        HRR: HRR {
            compatible = "zmk,behavior-hold-tap";
            label = "HRR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        enter_right {
            bindings = <&kp ENTER>;
            key-positions = <20 21>;
        };

        enter_left {
            bindings = <&kp ENTER>;
            key-positions = <15 14>;
        };

        apostrophe {
            bindings = <&kp APOSTROPHE>;
            key-positions = <31 30>;
        };

        quotation_mark {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <31 32>;
        };

        colon {
            bindings = <&kp COLON>;
            key-positions = <32 33>;
        };

        delete_right {
            bindings = <&kp DELETE>;
            key-positions = <22 23>;
        };

        backspace_right {
            bindings = <&kp BACKSPACE>;
            key-positions = <22 21>;
        };

        delete_Gutenberg {
            bindings = <&delete_Gutenberg>;
            key-positions = <12 13>;
        };

        backspace_left {
            bindings = <&kp BACKSPACE>;
            key-positions = <13 14>;
        };

        right_parenthesis {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <19 20>;
        };

        left_parenthesis {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <16 15>;
        };

        new_line_left {
            bindings = <&new_line>;
            key-positions = <15 14 13>;
        };

        new_line_right {
            bindings = <&new_line>;
            key-positions = <20 21 22>;
        };

        select_word_left {
            bindings = <&select_left_word>;
            key-positions = <12 13 14>;
        };

        select_right_word {
            bindings = <&select_right_word>;
            key-positions = <21 22 23>;
        };

        left_space_V1 {
            bindings = <&kp SPACE>;
            key-positions = <14 35>;
        };

        left_space_V2 {
            bindings = <&kp SPACE>;
            key-positions = <15 36>;
        };

        copy {
            bindings = <&kp LG(C)>;
            key-positions = <25 26>;
        };

        paste {
            bindings = <&kp LG(V)>;
            key-positions = <26 27>;
        };

        redo {
            bindings = <&kp LG(Z)>;
            key-positions = <24 25>;
        };
    };

    macros {
        lock_screen: lock_screen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LC(Q))>;
            label = "LOCK_SCREEN";
        };

        screen_shot: screen_shot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(NUMBER_4))>;
            label = "SCREEN_SHOT";
        };

        full_screen: full_screen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LC(F))>;
            label = "FULL_SCREEN";
        };

        eur_sign: eur_sign {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LA(NUMBER_2))>;
            label = "EUR_SIGN";
        };

        next_tab: next_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(TAB)>;
            label = "NEXT_TAB";
        };

        previous_tab: previous_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(TAB))>;
            label = "PREVIOUS_TAB";
        };

        new_tab: new_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(T)>;
            label = "NEW_TAB";
        };

        dock_expose: dock_expose {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(F3)>;
            label = "DOCK_EXPOSE";
        };

        new_line: new_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(ENTER)>;
            label = "NEW_LINE";
        };

        select_left_word: move_left_by_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LA(LEFT_ARROW))>;
            label = "MOVE_LEFT_BY_WORD";
        };

        select_right_word: select_right_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LA(RIGHT))>;
            label = "SELECT_RIGHT_WORD";
        };

        delete_Gutenberg: delete_Gutenberg {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LA(Z))>;
            label = "DELETE_GUTENBERG";
        };

        windows_dock: windows_dock {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(TAB)>;
            label = "WINDOWS_DOCK";
        };

        eur_win: eur_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_2 &kp KP_NUMBER_8>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "EUR_WIN";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "MacOS";

            // ------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |  MUTE |  PP   |  Y  |  U   |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |  LALT |  RALT |  H  |  J   |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  /  |
            //                    | GUI | LWR | SPC |               | ENT | RSE  | ALT |

            bindings = <
  &kp Q  &kp W  &kp E  &kp R  &kp B             &kp A  &none  &kp Y      &kp U            &kp I         &kp O       &kp P
  &kp A  &kp S  &kp D  &kp F  &kp G             &kp B  &none  &kp H      &kp J            &kp K         &kp L       &kp MINUS
  &kp Z  &kp X  &kp C  &kp V  &kp B                           &kp N      &kp M            &kp COMMA     &kp PERIOD  &kp SLASH
                &mo 2  &mo 1  &kp LEFT_COMMAND                &kp SPACE  &kp RIGHT_SHIFT  &kp LEFT_ALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        layer_1 {
            display-name = "NUMBER";

            // --------------------------------------------------------------------------------
            // |  1  |  2  |  3  |  4  |  5    |  LCTRL | RCTRL |  6  |  7  |  8  |  9  |  0  |
            // | BT1 | BT2 | BT3 | BT4 | BT5   |  LALT  | RALT  | LFT | DWN |  UP | RGT |     |
            // | BTCR| RGB | RST | BOOT| Unlock|        |       |     |     |     |     |     |
            //                    | GUI |     | SPC   |        | ENT   |     | ALT |

            bindings = <
  &kp ESCAPE  &lock_screen    &kp UP_ARROW    &screen_shot  &eur_sign         &none  &none  &kp PLUS       &kp N7           &kp N8        &kp N9        &kp KP_MULTIPLY
  &kp TAB     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT     &full_screen      &none  &none  &kp MINUS      &kp NUMBER_4     &kp N5        &kp NUMBER_6  &kp KP_DIVIDE
  &kp LCTRL   &previous_tab   &dock_expose    &next_tab     &new_tab                        &kp EQUAL      &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp SEMICOLON
                              &none           &none         &kp LEFT_COMMAND                &kp BACKSPACE  &kp RIGHT_SHIFT  &kp NUMBER_0
            >;
        };

        layer_2 {
            bindings = <
  &kp C_VOLUME_DOWN  &kp C_VOL_UP  &kp C_PREVIOUS  &kp C_PLAY_PAUSE      &kp C_NEXT  &trans  &trans  &trans  &trans        &trans        &trans        &trans
  &kp F14            &kp F15       &kp PAGE_UP     &kp K_SCROLL_UP       &none       &trans  &trans  &trans  &trans        &trans        &trans        &trans
  &none              &none         &kp PAGE_DOWN   &kp C_AC_SCROLL_DOWN  &none                       &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR
                                   &trans          &trans                &trans                      &trans  &to 6         &to 3
            >;

            label = "FUNCTION";
        };

        layer_3 {
            display-name = "WIN";
            bindings = <
  &kp Q  &kp W  &kp E  &kp R  &kp T             &none  &none  &kp Y      &kp U            &kp I         &kp O       &kp P
  &kp A  &kp S  &kp D  &kp F  &kp G             &none  &none  &kp H      &kp J            &kp K         &kp L       &kp MINUS
  &kp Z  &kp X  &kp C  &kp V  &kp B                           &kp N      &kp M            &kp COMMA     &kp PERIOD  &kp SLASH
                &mo 5  &mo 4  &kp LEFT_CONTROL                &kp SPACE  &kp RIGHT_SHIFT  &kp LEFT_WIN
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp PG_UP PG_DN>,
                <&inc_dec_kp C_PREV C_NEXT>,
                <&inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        layer_4 {
            display-name = "NUM";
            bindings = <
  &kp ESCAPE  &lock_screen    &kp UP_ARROW    &kp LG(LS(S))  &eur_win          &none  &none  &kp PLUS       &kp N7           &kp N8        &kp N9        &kp KP_MULTIPLY
  &kp TAB     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT      &full_screen      &none  &none  &kp MINUS      &kp NUMBER_4     &kp N5        &kp NUMBER_6  &kp KP_DIVIDE
  &kp LCTRL   &previous_tab   &windows_dock   &next_tab      &new_tab                        &kp EQUAL      &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp SEMICOLON
                              &none           &none          &kp LEFT_COMMAND                &kp BACKSPACE  &kp RIGHT_SHIFT  &kp NUMBER_0
            >;
        };

        layer_5 {
            label = "FUN";
            bindings = <
  &kp C_VOLUME_DOWN  &kp C_VOL_UP  &kp K_MUTE     &kp F4                &kp F1  &trans  &trans  &trans  &trans  &trans  &trans  &trans
  &kp F14            &kp F15       &kp PAGE_UP    &kp K_SCROLL_UP       &none   &trans  &trans  &trans  &trans  &trans  &trans  &trans
  &none              &none         &kp PAGE_DOWN  &kp C_AC_SCROLL_DOWN  &none                   &trans  &trans  &trans  &trans  &trans
                                   &trans         &trans                &trans                  &trans  &trans  &to 0
            >;
        };

        layer_6 {
            bindings = <
  &kp ESCAPE      &kp Q  &kp W   &kp E   &kp R      &trans  &trans  &trans  &trans  &trans  &trans  &trans
  &kp LCTRL       &kp A  &kp S   &kp D   &kp F      &trans  &trans  &trans  &trans  &trans  &trans  &trans
  &kp LEFT_SHIFT  &kp Z  &kp X   &kp C   &kp V                      &trans  &trans  &trans  &trans  &trans
                         &trans  &trans  &kp SPACE                  &trans  &to 0   &trans
            >;

            label = "GAME";
        };
    };
};
